# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# AI mode: development | staging | production
AI_MODE=development

# NVIDIA API Credentials
NVIDIA_API_KEY=your_nvidia_api_key_here
GENERAL_CHAT_API_KEY=your_general_chat_api_key_here
NVIDIA_MODEL=qwen/qwen3-next-80b-a3b-instruct
ENABLE_MODEL_ROUTING=true

# Google Cloud (Gemini / Vertex AI — optional)
GOOGLE_CLOUD_PROJECT=your_gcp_project_id
GOOGLE_CLOUD_LOCATION=global
GOOGLEMAP_API=your_google_maps_api_key

# ElevenLabs (voice — optional)
ELEVENLABS_API_KEY=your_elevenlabs_api_key

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/Velora

# Redis Configuration (Optional, falls back to memory if not provided)
REDIS_URL=redis://default:gQAAAAAAAkvkAAIgcDI4MDMxOWFjYTk0ZTc0NDc3YmFkN2U5MThjMWRjZmE0Ng@true-moth-150500.upstash.io:6379

# Security Configuration
JWT_SECRET=generate_a_long_random_secret_here

# LLM request timeout (milliseconds)
LLM_TIMEOUT_MS=60000

# Enable safe real-time streaming response engine (default false)
ENABLE_STREAMING=false
