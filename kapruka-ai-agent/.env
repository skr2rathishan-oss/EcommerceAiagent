# Server Configuration
PORT=
NODE_ENV=
FRONTEND_URL=http://localhost:517

# AI mode (development)
AI_MODE=development

# Google Cloud (Gemini / Vertex AI — optional)
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=
GOOGLEMAP_API=

# ElevenLabs (voice — optional)
ELEVENLABS_API_KEY=

# Database Configuration
MONGODB_URI=

# Redis Configuration (Optional, falls back to memory if not provided)
REDIS_URL=

# Security Configuration
JWT_SECRET=

# LLM request timeout (milliseconds)
LLM_TIMEOUT_MS=

# Enable safe real-time streaming response engine
ENABLE_STREAMING=true
DEBUG_LOGGING=true
